<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <!--
    Databricks builds need public repositories, unlike the internal Artifactory settings in
    ../settings.xml. POM repository ordering alone is insufficient: Assembly loads dependency
    POMs through Maven's session-level repositories. This active profile applies Google-first
    ordering to those requests too. Use repository entries rather than a Central mirror so
    Central remains available as a fallback.
  -->
  <profiles>
    <profile>
      <id>public-repositories</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>public-repositories</activeProfile>
  </activeProfiles>
</settings>
