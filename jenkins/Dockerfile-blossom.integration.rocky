# Build the Rocky Linux environment for Spark integration tests.

ARG CUDA_VER=11.8.0
ARG ROCKY_VER=8
FROM nvidia/cuda:${CUDA_VER}-runtime-rockylinux${ROCKY_VER}
ARG CUDA_VER
ARG CUDF_VER
ARG ART_URL

# Install Spark's supported JDKs side by side.
RUN yum update -y && \
    yum install epel-release -y && \
    yum install -y java-1.8.0-openjdk-devel java-11-openjdk-devel java-17-openjdk-devel java-21-openjdk-devel \
        wget expect rsync zip unzip procps git

# Install the Maven distribution used by the Scala Maven plugin.
ENV MAVEN_HOME "/usr/local/apache-maven-3.8.1"
RUN wget ${ART_URL}/org/apache/maven/apache-maven/3.8.1/apache-maven-3.8.1-bin.tar.gz -P /usr/local && \
    tar xzvf $MAVEN_HOME-bin.tar.gz -C /usr/local && \
    rm -f $MAVEN_HOME-bin.tar.gz

RUN wget --quiet https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O ~/miniconda.sh && \
    /bin/bash ~/miniconda.sh -b -p /opt/conda && \
    rm -f ~/miniconda.sh
ENV PATH="/opt/conda/bin:$MAVEN_HOME/bin:${PATH}"
ENV CONDA_PLUGINS_AUTO_ACCEPT_TOS="yes"
RUN conda init && conda config --set channel_priority strict

# Keep Python compatible with the oldest supported Spark runtime.
RUN conda install -y -c conda-forge -c anaconda -c defaults \
        python=3.10 && \
    conda clean -ay
COPY integration_tests/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

# Set the default JDK for Maven jobs.
ENV JAVA_HOME "/usr/lib/jvm/java-1.8.0-openjdk"
