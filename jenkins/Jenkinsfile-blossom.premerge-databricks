/**
 *
 * Jenkinsfile for building rapids-plugin on Databricks cluster
 *
 */

@Library('blossom-lib@main')
@Library('blossom-github-lib@master')

import ipp.blossom.*

def githubHelper // blossom github helper
def IMAGE_DB = pod.getCPUYAML("${common.ARTIFACTORY_NAME}/sw-spark-docker/spark:rapids-databricks-ubuntu22")

pipeline {
    agent {
        kubernetes {
            label "premerge-init-${BUILD_TAG}"
            cloud "${common.CLOUD_NAME}"
            yaml "${IMAGE_DB}"
        }
    }

    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '50'))
        skipDefaultCheckout true
        timeout(time: 12, unit: 'HOURS')
    }

    parameters {
        string(name: 'REF', defaultValue: 'main',
            description: 'Merged commit SHA; legacy branch refs resolve from the PR metadata')
        string(name: 'GITHUB_DATA', defaultValue: '',
            description: 'Json-formatted github data from upstream blossom-ci')
        choice(name: 'TEST_MODE', choices: ['CI_PART1', 'CI_PART2'],
            description: 'Separate integration tests into 2 parts, and run each part in parallell')
        // Parameter definitions are shared with old branches; retain even when unused here.
        string(name: 'PLUGIN_BUILT_DIR', defaultValue: 'dbfs:/cicd',
            description: 'Legacy CI_PART1 artifact path for CI_PART2; unused by independent builds')
    }

    environment {
        GITHUB_TOKEN = credentials("github-token")
        CUSTOM_WORKSPACE = "/home/jenkins/agent/workspace/${BUILD_TAG}"
        // DB related ENVs
        IDLE_TIMEOUT = '390' // 6.5 hours
        NUM_WORKERS = '0'
        DB_TYPE = getDbType()
        DATABRICKS_HOST = DbUtils.getHost("$DB_TYPE")
        DATABRICKS_TOKEN = credentials("${DbUtils.getToken("$DB_TYPE")}")
        DATABRICKS_PUBKEY = credentials("SPARK_DATABRICKS_PUBKEY")
        DATABRICKS_DRIVER = DbUtils.getDriver("$DB_TYPE")
        DATABRICKS_WORKER = DbUtils.getWorker("$DB_TYPE")
        TEST_TYPE = 'pre-commit'
    }

    stages {
        stage("Init githubHelper") {
            steps {
                script {
                    githubHelper = GithubHelper.getInstance("${GITHUB_TOKEN}", params.GITHUB_DATA)
                    // desc contains the PR ID and can be accessed from different builds
                    currentBuild.description = githubHelper.getBuildDescription() + " | $TEST_MODE"
                    def title = githubHelper.getIssue().title.toLowerCase()
                    env.REDUCED_IT = (title ==~ /.*\[reduced-it\].*/).toString()
                    // New parents pin both parts to one SHA; older parents pass branch refs.
                    def sourceSha = (params.REF ==~ /[0-9a-f]{40}/) ?
                        params.REF : githubHelper.getMergedSHA()
                    checkoutCode(githubHelper.getCloneUrl(), sourceSha)
                }
            }
        } // end of Init githubHelper

        stage('Databricks') {
            failFast true // Abort running if one branch failed
            matrix {
                axes {
                    axis {
                        // 'name' and 'value' only supprt literal string in the declarative Jenkins
                        // Refer to Jenkins issue https://issues.jenkins.io/browse/JENKINS-62127
                        name 'DB_RUNTIME'
                        values '14.3', '17.3', '18.3'
                    }
                }
                stages {
                    stage('Build') {
                        agent {
                            kubernetes {
                                label "premerge-ci-${DB_RUNTIME}-${BUILD_NUMBER}"
                                cloud "${common.CLOUD_NAME}"
                                yaml "${IMAGE_DB}"
                                customWorkspace "${CUSTOM_WORKSPACE}-${DB_RUNTIME}-${BUILD_NUMBER}"
                            }
                        }
                        environment {
                            DATABRICKS_RUNTIME = DbUtils.getRuntime("$DB_RUNTIME")
                            BASE_SPARK_VERSION = DbUtils.getSparkVer("$DB_RUNTIME")
                            BASE_SPARK_VERSION_TO_INSTALL_DATABRICKS_JARS = DbUtils.getInstallVer("$DB_RUNTIME")
                            INIT_SCRIPTS = DbUtils.getInitScripts("$DB_RUNTIME")
                            INIT_SCRIPTS_DIR = "/databricks/init_scripts/${BUILD_TAG}-${DB_RUNTIME}"
                            EXTRA_ENVS = "TEST_MODE=$TEST_MODE,REDUCED_IT=$REDUCED_IT"
                        }
                        steps {
                            script {
                                container('cpu') {
                                    try {
                                        unstash('source_tree')
                                        load('jenkins/databricks/fallback.groovy').run(this, DbUtils, getDbRetryOrder(),
                                            { clusterId -> databricksBuild(clusterId) },
                                            { clusterId -> databricksTest(clusterId) })
                                    } catch (e) {
                                        try {
                                            withCredentials([usernamePassword(
                                                credentialsId: 'urm_creds',
                                                usernameVariable: 'ART_CREDS_USR',
                                                passwordVariable: 'ART_CREDS_PSW')]) {
                                                common.uploadDebugBundle(this, 'spark-rapids', "databricks-${DB_RUNTIME}")
                                            }
                                        } catch (debugError) {
                                            echo "Failed to collect or upload debug bundle: ${debugError}"
                                        }
                                        throw e
                                    }
                                }
                            }
                        }
                    }
                }
            } // end of matrix
        } // end of stage Databricks
    } // end of stages
} // end of pipeline

List<String> getDbTypes() {
    return ['aws2', 'aws', 'azure3']
}

String getDbType() {
    // Match the initial environment to the fixed fallback order until the 26.10 release.
    // TODO: Restore parameter selection together with getDbRetryOrder() after the release.
    // def types = getDbTypes()
    // def selected = params.DATABRICKS_TYPE ?: types[0]
    // if (!(selected in types)) {
    //     error "Unsupported Databricks profile: $selected"
    // }
    // return selected
    return getDbTypes()[0]
}

List<String> getDbRetryOrder() {
    // Keep this order independent of DATABRICKS_TYPE while 26.10 lacks fallback support.
    // TODO: Restore selected-provider-first ordering after the 26.10 release.
    // def selected = getDbType()
    // return [selected] + getDbTypes().findAll { it != selected }
    return getDbTypes()
}

void databricksBuild(String clusterId) {
    def SPARK_MAJOR = BASE_SPARK_VERSION_TO_INSTALL_DATABRICKS_JARS.replace('.', '')
    stage("Build against $SPARK_MAJOR DB") {
        sh "rm -rf spark-rapids-ci.tgz"
        sh "tar -zcf spark-rapids-ci.tgz * .git"
        withCredentials([file(credentialsId: 'SPARK_DATABRICKS_PRIVKEY', variable: 'DATABRICKS_PRIVKEY')]) {
            def BUILD_PARAMS = DbUtils.getParameters(this, 'BUILD', "-c $clusterId")
            sh "python3 ./jenkins/databricks/run-build.py $BUILD_PARAMS"
        }
        sh "rm spark-rapids-ci.tgz"
    }
}

void databricksTest(String clusterId) {
    def SPARK_MAJOR = BASE_SPARK_VERSION_TO_INSTALL_DATABRICKS_JARS.replace('.', '')
    def stageName = "Test against $SPARK_MAJOR DB"
    try {
        stage(stageName) {
            withCredentials([file(credentialsId: 'SPARK_DATABRICKS_PRIVKEY', variable: 'DATABRICKS_PRIVKEY')]) {
                def TEST_PARAMS = DbUtils.getParameters(this, 'TEST', "-c $clusterId")
                sh "python3 ./jenkins/databricks/run-tests.py $TEST_PARAMS"
            }
        }
    } finally {
        common.publishPytestResult(this, "Test against $SPARK_MAJOR DB")
    }
}

void checkoutCode(String url, String sha) {
    checkout(
        changelog: false,
        poll: true,
        scm: [
            $class           : 'GitSCM', branches: [[name: sha]],
            userRemoteConfigs: [[
                                    credentialsId: 'github-token',
                                    url          : url,
                                    refspec      : '+refs/pull/*/merge:refs/remotes/origin/pr/*']],
             extensions      : [[$class: 'CloneOption', shallow: true, depth: 10]]
        ]
    )
    sh "git submodule update --init"
    if (!common.isSubmoduleInit(this)) {
        error "Failed to clone submodule : thirdparty/parquet-testing"
    }

    stash(name: 'source_tree', includes: '**,.git/**', useDefaultExcludes: false)
}
