<ivysettings>
  <!-- Spark's runtime package resolver needs binary JARs, not IDE attachments. -->
  <property name="ivy.maven.lookup.sources" value="false"/>
  <property name="ivy.maven.lookup.javadoc" value="false"/>
  <settings defaultResolver="iceberg-packages"/>
  <resolvers>
    <chain name="iceberg-packages" returnFirst="true">
      <ibiblio name="staged-maven" m2compatible="true" root="file:${user.home}/.m2/repository/"/>
      <ibiblio name="google-maven-central" m2compatible="true" root="https://maven-central.storage-download.googleapis.com/maven2/"/>
    </chain>
  </resolvers>
</ivysettings>
