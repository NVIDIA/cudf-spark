/**
 * Standalone Blossom pipeline for validating the Skills premerge image and script.
 */
@Library('blossom-lib') _

def IMAGE_SKILLS = "${common.ARTIFACTORY_NAME}/sw-spark-docker/plugin:" +
    "skills-premerge-rockylinux8-cuda12.9.1-blossom-dev"

pipeline {
    agent none

    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout true
        timeout(time: 3, unit: 'HOURS')
    }

    parameters {
        string(name: 'REF', defaultValue: 'main',
            description: 'Branch to test')
        string(name: 'REPO_URL', defaultValue: 'https://github.com/NVIDIA/cudf-spark.git',
            description: 'cudf-spark repository URL')
        string(name: 'GPU_TYPE', defaultValue: 'NIGHTLY_POOL',
            description: 'https://prod.blsm.nvidia.com/sw-gpu-spark-jenkins/lockable-resources/')
    }

    environment {
        ART_CREDS = credentials('urm_creds')
        ARTIFACTORY_NAME = "${common.ARTIFACTORY_NAME}"
        ART_URL = "https://${common.ARTIFACTORY_NAME}/artifactory/sw-spark-maven"
        LIBCUDF_KERNEL_CACHE_PATH = '/tmp/.cudf'
        CUSTOM_WORKSPACE = "/home/jenkins/agent/workspace/${BUILD_TAG}"
    }

    stages {
        stage('Skills Premerge Test') {
            options {
                lock(label: "${params.GPU_TYPE}", quantity: 1, variable: 'GPU_RESOURCE')
            }

            agent {
                kubernetes {
                    label "skills-premerge-standalone-${BUILD_TAG}"
                    cloud "${common.CLOUD_NAME}"
                    yaml pod.getGPUYAML("${IMAGE_SKILLS}", "${env.GPU_RESOURCE}", '8', '32Gi')
                    customWorkspace "${CUSTOM_WORKSPACE}"
                }
            }

            steps {
                checkout(
                    changelog: false,
                    poll: false,
                    scm: [
                        $class           : 'GitSCM',
                        branches         : [[name: "${params.REF}"]],
                        extensions       : [[$class: 'CloneOption', shallow: true, depth: 10]],
                        userRemoteConfigs: [[
                            credentialsId: 'github-token',
                            url          : "${params.REPO_URL}"
                        ]]
                    )

                container('gpu') {
                    script {
                        currentBuild.description = "${params.REF}@${params.REPO_URL}"
                        timeout(time: 90, unit: 'MINUTES') {
                            try {
                                common.resolveIncompatibleDriverIssue(this)
                                common.restoreM2Cache(this)
                                common.prepareArtNetrc(this)
                                sh '''
                                    mkdir -p "$HOME/.m2"
                                    cp jenkins/settings.xml "$HOME/.m2/settings.xml"
                                '''
                                sh 'skills/ci/pre-merge.sh'
                            } catch(e) {
                                common.printJVMCoreDumps(this)
                                common.uploadDebugBundle(this, 'spark-rapids', 'skills-standalone')
                                throw e
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Skills standalone premerge finished.'
        }
    }
}
